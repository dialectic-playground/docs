{
  // Dev container for VS Code, JetBrains, and Codespaces. It uses the same image as
  // `make` and CI (../Containerfile). For Podman, set "dev.containers.dockerPath": "podman".
  "name": "dialectic-playground/docs",
  "build": { "dockerfile": "../Containerfile", "context": "." },
  "containerEnv": { "DP_IN_CONTAINER": "1", "DP_BIND_ADDRESS": "0.0.0.0" },
  "forwardPorts": [8000],
  "updateRemoteUserUID": true
}
